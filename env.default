# Settings for renci-ner. Copy this file to .env (which is gitignored) and fill it in.
# renci-ner reads .env from the current directory or the nearest parent directory that
# has one. A variable set in the environment overrides the same variable here, and a
# variable left empty counts as unset.

# Credentials for Bagel (https://bagel.apps.renci.org), the LLM-based re-ranker.
BAGEL_USERNAME=
BAGEL_PASSWORD=
