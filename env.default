# Settings for renci-ner. Copy this file to .env (which is gitignored) and fill it in.
# renci-ner reads .env from the current directory or the nearest parent directory that
# has one. A variable set in the environment overrides the same variable here, and a
# variable left empty counts as unset.

# Credentials for Bagel (https://bagel.apps.renci.org), the LLM-based re-ranker.
BAGEL_USERNAME=
BAGEL_PASSWORD=

# Service URLs, to use another instance (e.g. a development deployment, or a port-forward
# when BioMegatron isn't reachable from outside RENCI). Each defaults to the RENCI-hosted
# service shown, and annotations record the URL actually used in their provenance.
# BIOMEGATRON_URL=https://med-nemo.apps.renci.org
# NAMERES_URL=https://name-resolution-sri.renci.org
# SAPBERT_URL=https://sap-qdrant.apps.renci.org
# NODENORM_URL=https://nodenormalization-sri.renci.org
# BAGEL_URL=https://bagel.apps.renci.org
